<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons"
>
    <ScrollContainer
        id="caddetail_scrollAssemblycontainerMain"
        width="100%"
        height="auto"
        horizontal="true"
        vertical="true"
        focusable="true"
    >
        <Table
            items="{
                path: 'EntryFormDataSourceModel>/Assembly',
                sorter: {
                    path: 'SNo'
                }
            }"
            width="100%"
            id="caddetail_AssemblyTable"
            class="sapUiSizeCompact"
            inset="true"
            sticky="ColumnHeaders,HeaderToolbar"
            showSeparators="All"
            showNoData="true"
        >
            <!-- ✅ Header Toolbar with Add Row Button -->
            <headerToolbar>
                <Toolbar>
                    <ToolbarSpacer />
                    <Button
                        id="Assembly_addRow"
                        text="Add Row"
                        icon="sap-icon://add"
                        type="Emphasized"
                        press=".onAddAssemblyRow"
                    />
                </Toolbar>
            </headerToolbar>

            <!-- ✅ Table Columns -->
            <columns>
                <Column width="10rem">
                    <Text text="Item Name" />
                </Column>
                <Column width="10rem">
                    <Text text="Item Code" />
                </Column>
                <Column width="3.125rem">
                    <Text text="Action" />
                </Column>
            </columns>

            <!-- ✅ Table Rows -->
            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <!-- Item Name -->
                        <Input
                            id="caddetail_ItemName"
                            width="10rem"
                            showValueHelp="true"
                            valueHelpRequest="cflForName"
                            value="{EntryFormDataSourceModel>ItemName}"
                            editable="true"
                            required="true"
                        />

                        <!-- Item Code -->
                        <Input
                            id="caddetail_ItemCode"
                            width="10rem"
                            value="{EntryFormDataSourceModel>ItemCode}"
                            editable="false"
                            required="true"
                        />

                        <!-- ✅ Delete Row Button -->
                        <Button
                            id="caddetail_AssemblyDeletebtn"
                            icon="sap-icon://delete"
                            type="Transparent"
                            tooltip="Delete Row"
                            press=".onDeleteAssemblyRow"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
