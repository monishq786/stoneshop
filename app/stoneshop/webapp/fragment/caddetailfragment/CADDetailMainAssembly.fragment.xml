<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons"
>
    <ScrollContainer
        id="caddetail_scrollcontainerMain"
        width="100%"
        height="auto"
        horizontal="true"
        vertical="true"
        focusable="true"
    >
        <Table
            items="{
                path: 'EntryFormDataSourceModel>/MainAssembly',
                sorter: {
                    path: 'SNo'
                }
            }"
            width="100%"
            id="caddetail_mainAssemblyTable"
            class="sapUiSizeCompact"
            inset="true"
            sticky="ColumnHeaders,HeaderToolbar"
            showSeparators="All"
            showNoData="true"
        >
            <columns>
                <Column width="8.75rem">
                    <Text
                        text="Product Code"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="Product Name/Description"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="Quantity"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="Remarks"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="Weight"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="Weight (UOM)"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="SCIPL Code"
                    />
                </Column>
                <Column width="8.75rem">
                    <Text
                        text="PD Number"
                    />
                </Column>
            </columns>

            <items>
                <ColumnListItem vAlign="Middle">
                    <cells>
                        <!-- Product Code -->
                        <Input
                            id="caddetail_productNo"
                            showValueHelp="true"
                            valueHelpRequest="cflForProductNo"
                            value="{EntryFormDataSourceModel>ProductNo}"
                            editable="true"
                            required="true"
                        />

                        <!-- Product Name -->
                        <Input
                            id="caddetail_productName"
                            value="{EntryFormDataSourceModel>ProductName}"
                            tooltip="{EntryFormDataSourceModel>ProductName}"
                            editable="false"
                            required="true"
                        />

                        <!-- Product Quantity -->
                        <Input
                            id="caddetail_productQty"
                            value="{EntryFormDataSourceModel>Quantity}"
                            editable="false"
                            required="true"
                        />

                        <!-- Remarks -->
                        <Input
                            id="caddetail_mainRemarks"
                            value="{EntryFormDataSourceModel>Remarks}"
                            editable="true"
                        />

                        <Input
                            id="caddetail_weight"
                            value="{EntryFormDataSourceModel>Weight}"
                            editable="false"
                            required="true"
                        />

                        <Input
                            id="caddetail_weightuom"
                            value="{EntryFormDataSourceModel>WeightUOMCode}"
                            editable="false"
                            required="true"
                        />

                        <Input
                            id="caddetail_scipl"
                            value="{EntryFormDataSourceModel>SCIPLCode}"
                            editable="false"
                            required="true"
                        />

                        <Input
                            id="caddetail_pdnumber"
                            value="{EntryFormDataSourceModel>PDNumber}"
                            editable="false"
                            required="true"
                        />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </ScrollContainer>
</core:FragmentDefinition>
