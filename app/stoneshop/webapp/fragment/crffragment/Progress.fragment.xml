    <ui:TreeTable
        id="TreeTableBasic"
        rows="{testdata>/node}"
        selectionMode="None"
        width="auto"
    >
        <ui:rowMode>
            <rowmodes:Fixed rowCount="5" />
        </ui:rowMode>
        <ui:columns>
            <ui:Column width="3.125rem">
                <Label text="Sr No." />
                <ui:template>
                    <Text
                        text="{testdata>rowNumber}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="Stage" />
                <ui:template>
                    <Text
                        text="{testdata>name}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="9.375rem">
                <Label text="Role" />
                <ui:template>
                    <Text
                        text="{testdata>role}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="Start Date" />
                <ui:template>
                    <Text
                        text="{testdata>startdate}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="End Date" />
                <ui:template>
                    <Text
                        text="{testdata>enddate}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="Approval Status" />
                <ui:template>
                    <Text
                        text="{testdata>taskstatus}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="Completion Status" />
                <ui:template>
                    <Text
                        text="{testdata>completionstatus}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="200px">
                <Label text="Comments" />
                <ui:template>
                    <Text
                        text="{testdata>comment}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
            <ui:Column width="9.375rem">
                <Label text="Nature" />
                <ui:template>
                    <Text
                        text="{testdata>nature}"
                        wrapping="false"
                    />
                </ui:template>
            </ui:Column>
        </ui:columns>
    </ui:TreeTable>

