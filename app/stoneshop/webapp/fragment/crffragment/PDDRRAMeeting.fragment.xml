<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
    xmlns:commons="sap.suite.ui.commons"
>
    <VBox>
        <FlexBox justifyContent="End">
            <Button
                id="clearTimeBtn"
                icon="sap-icon://synchronize"
                text="{i18n>reschedule}"
                press="onClearTimePress"
                class="sapUiSmallMarginBegin"
            />
            <Button
                id="availableBtn"
                icon="sap-icon://check-availability"
                text="{i18n>checkAvailability}"
                press="getAvailableUsers"
                class="sapUiSmallMarginBegin"
            />
            <Button
                id="pddrraBtn"
                icon="sap-icon://add"
                text="{i18n>addDrawing}"
                press="addMeeting"
                class="sapUiSmallMarginBegin"
            />
        </FlexBox>
        <f:SimpleForm
            id="PDDRAForm"
            editable="true"
            layout="ColumnLayout"
            columnsM="2"
            columnsL="4"
            columnsXL="4"
            labelSpanL="4"
            labelSpanXL="4"
            adjustLabelSpan="true"
        >
            <f:content>
                <Label
                    id="timeSlotLbl"
                    text="Select Time Slot"
                />
                <Select
                    id="timeSlotCombo"
                    forceSelection="false"
                    items="{TimeSlotModel>/TimeSlots}"
                    change="getSelectedTime"
                >
                    <items>
                        <core:Item
                            key="{TimeSlotModel>SlotID}"
                            text="{TimeSlotModel>SlotDescription}"
                        />
                    </items>
                </Select>
                <Label
                    id="meetingDteLbl"
                    text="Meeting Date"
                />
                <DatePicker
                    id="meetingDte"
                    minDate="{EntryFormDataSourceModel>/minDate}"
                    value="{EntryFormDataSourceModel>/MeetingDate}"
                    class="sapUiSmallMarginBottom"
                    afterValueHelpOpen="handleBeforeSelectionMeetingDate"
                    change="getMeetingDate"
                />
                <Label
                    id="startTimeLbl"
                    text="Start Time"
                />
                <TimePicker
                    id="startTime"
                    placeholder="Enter Time"
                    class="sapUiSmallMarginBottom"
                    displayFormat="hh:mm a"
                    valueFormat="HH:mm"
                    value=""
                    change="getMeetingDate"
                />
                <Label
                    id="endTimeLbl"
                    text="End Time"
                />
                <TimePicker
                    id="endTime"
                    placeholder="Enter Time"
                    displayFormat="hh:mm a"
                    valueFormat="HH:mm"
                    value=""
                    change="getMeetingDate"
                />
            </f:content>
        </f:SimpleForm>

        <ScrollContainer
            id="scrollPDDRA"
            width="100%"
            height="auto"
            horizontal="true"
            vertical="true"
            focusable="true"
        >
            <Table
                items="{    path: 'EntryFormDataSourceModel>/UserAssign',    sorter: {     path: 'Name'    }   }"
                id="pddrraTable"
                class="sapUiSizeCompact"
                inset="true"
                sticky="ColumnHeaders,HeaderToolbar"
                showSeparators="All"
                showNoData="true"
            >
                <columns>
                    <Column width="5rem">
                        <Label text="Sr. No" />
                    </Column>
                    <Column width="10rem">
                        <Label
                            text="Department"
                            labelFor="departmentMeetingDialog"
                        />
                    </Column>
                    <Column width="10rem">
                        <Label
                            text="User"
                            labelFor="pddrraUserName"
                        />
                    </Column>
                    <Column width="10rem">
                        <Label text="Call Meeting" />
                    </Column>
                    <Column width="10rem">
                        <Label text="Meeting Attended" />
                    </Column>
                    <Column width="13rem">
                        <Label
                            text="Start Date Time"
                            labelFor="startDteTime"
                        />
                    </Column>
                    <Column width="13rem">
                        <Label
                            text="End Date Time"
                            labelFor="endDteTime"
                        />
                    </Column>
                    <Column width="10rem">
                        <Label text="Availability" />
                    </Column>
                    <Column width="10rem">
                        <Label text="Remarks" />
                    </Column>
                    <Column width="5rem">
                        <Text text="Action" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem vAlign="Middle">
                        <cells>
                            <Text
                                id="srNum_pddra"
                                text="{EntryFormDataSourceModel>RowNumber}"
                            />
                            <Input
                                id="departmentMeeting"
                                required="true"
                                editable="{= ${EntryFormDataSourceModel>isEditable} ? true : false}"
                                width="9.375rem"
                                placeholder="Click to select value"
                                showValueHelp="true"
                                valueHelpRequest="cflForDeptPddra"
                                value="{EntryFormDataSourceModel>DepartmentName}"
                            />
                            <Input
                                id="pddrraUserName"
                                required="true"
                                editable="{= ${EntryFormDataSourceModel>isEditable} ? true : false}"
                                width="9.375rem"
                                placeholder="Click to select value"
                                showValueHelp="true"
                                valueHelpRequest="cflForUserPddra"
                                value="{EntryFormDataSourceModel>UserName}"
                            />
                            <Select
                                id="callMeeting"
                                enabled="true"
                                width="9.375rem"
                                maxWidth="100%"
                                valueState="None"
                                visible="true"
                                editable="{EnableCheck>/EnableDisbale}"
                                selectedKey="{EntryFormDataSourceModel>CallMeeting}"
                                items="{path:'ReqTypeModel>/callMeeting',templateShareable:false}"
                            >
                                <items>
                                    <core:Item
                                        key="{ReqTypeModel>id}"
                                        text="{ReqTypeModel>name}"
                                    />
                                </items>
                            </Select>
                            <Select
                                id="meetingAttended"
                                width="9.375rem"
                                maxWidth="100%"
                                valueState="None"
                                visible="true"
                                editable="{EnableCheck>/EnableDisbale}"
                                selectedKey="{EntryFormDataSourceModel>IsMeetingAttended}"
                                change="onColorComboChange"
                                items="{path:'ReqTypeModel>/meetingAttanded',templateShareable:false}"
                            >
                                <items>
                                    <core:Item
                                        key="{ReqTypeModel>id}"
                                        text="{ReqTypeModel>name}"
                                    />
                                </items>
                            </Select>
                            <Input
                                id="startDteTime"
                                required="true"
                                editable="false"
                                width="200px"
                                fieldWidth="100%"
                                value="{EntryFormDataSourceModel>MeetingStartDate}"
                            />
                            <Input
                                id="endDteTime"
                                required="true"
                                editable="false"
                                width="200px"
                                fieldWidth="100%"
                                value="{EntryFormDataSourceModel>MeetingEndDate}"
                            />
                            <Input
                                id="userAvailable"
                                editable="false"
                                width="9.375rem"
                                fieldWidth="100%"
                                value="{EntryFormDataSourceModel>UserAvailable}"
                            />
                            <Input
                                id="pddrraRemarks"
                                tooltip="{EntryFormDataSourceModel>Remarks}"
                                placeholder="Remarks"
                                width="9.375rem"
                                fieldWidth="100%"
                                value="{EntryFormDataSourceModel>Remarks}"
                            />
                            <Button
                                id="pddrraDelBtn"
                                icon="sap-icon://delete"
                                press="onDeleteMeeting"
                                type="Reject"
                                visible="{= ${EntryFormDataSourceModel>CrfUserAssgGuid} ? false : true }"
                            />
                            <!-- visible="{= ${EntryFormDataSourceModel>isEditable} ? true : false}" -->
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </ScrollContainer>
    </VBox>
</core:FragmentDefinition>
